# Postgres — consumed by the db container's initdb on FIRST boot only.
# Changing it later does NOT change a running database's password. To rotate:
#   docker compose exec db psql -U inventory -c "\password inventory"   (then update this file's values too)
POSTGRES_USER=inventory
# Required — generate one: openssl rand -base64 24  (any long random string)
POSTGRES_PASSWORD=
POSTGRES_DB=inventory

# Local dev only (npm run dev / prisma migrate dev). Inside Docker, compose
# derives the container DATABASE_URL from POSTGRES_* above and overrides this.
# Keep the password here in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://inventory:CHANGE-ME@localhost:5432/inventory

# Phase 2+: Auth.js
AUTH_SECRET=generate-with--npx-auth-secret

# Phase 3+: AES-256-GCM key for asset secrets (32 bytes, base64)
SECRET_ENCRYPTION_KEY=generate-32-byte-base64-key

# The password every seeded account shares. Unset is FINE for local development
# and is what the test suite expects — prisma/fixtures.ts falls back to a value
# published in README, which is safe only for a database nothing can reach.
#
# `npm run db:seed` REFUSES to run when NODE_ENV=production and this is unset,
# and the production image sets NODE_ENV=production. So set this before seeding
# anything a phone can reach, and do not commit the value you choose.
#
# DO NOT set this for LOCAL development. The seed reads .env (Prisma Client
# loads it), but the Playwright process that imports the same constant to type
# a password into the login form does NOT reliably load .env. Set it locally
# and the two disagree about what the password is, and EVERY e2e login fails
# with no hint as to why. Locally, leave it unset and let the fixture default
# apply to both halves.
# SEED_PASSWORD=

# Phase 11+: the absolute base URL a printed label's QR code sends a phone to.
#
# REQUIRED for QR codes. Without it, labels still print their Code 128 barcode
# and the sheet states why no QR appeared. There is deliberately NO default: a
# default here would be a dead link printed onto adhesive paper.
#
# >>> THE VALUE BELOW IS A PLACEHOLDER. CHANGE IT BEFORE PRINTING ANY LABEL. <<<
#
# Use a HOSTNAME YOU CONTROL, not the server's IP address. Whatever is set here
# is baked permanently into every sticker: a DHCP lease renewal or a machine
# swap would kill every label already stuck to a device, and you would only find
# out when someone scanned one. A hostname can be repointed; an IP cannot.
#
# A localhost / 127.x / 0.0.0.0 value is REFUSED rather than printed. Note the
# third one especially: `docker ps` displays this project's own web service as
# 0.0.0.0:3000->3000/tcp, so it is the value most likely to be copied by
# mistake, and it scans perfectly on this machine and on no phone.
#
# Phones must also be able to REACH this address, which has consequences —
# see "Scanning a label with a phone" in README.md before you enable it.
APP_BASE_URL=http://inventory.example.local:3000

# STAGING ONLY — never set in production. Comma-separated accounts that get a
# one-click, no-password "Continue as {role}" button on /login. Unset or empty
# turns the feature off entirely (no buttons, no quick-login provider).
# QUICK_LOGIN_EMAILS=it@example.com,admin@example.com
# On Vercel (public internet) the list above is ignored unless this is also 1.
# Set it only while presenting; delete it and redeploy afterwards.
# QUICK_LOGIN_PUBLIC=

# Phase 41: Cris, the in-app IT assistant. The owner pastes the Anthropic key into
# the server's .env themselves; it is never stored in the database or shown. Without
# it Cris runs in preview mode: Cris shows up and chats, but only with friendly
# placeholder replies (no AI calls, no cost, no lookups, no changes), and Settings ›
# Cris says "No AI key on the server — Cris is in preview: placeholder replies only."
# Adding the key (and restarting) switches Cris to the real model; nothing else to do.
# ANTHROPIC_API_KEY=
#
# Dev and e2e only: set CRIS_MODEL to "fake" for scripted, deterministic replies with
# no key and no cost. The fake is REFUSED when NODE_ENV=production (staging and
# production use the real model, or preview mode when there is no key).
# CRIS_MODEL=

# Cloud staging (Vercel + Supabase) ONLY. Leave all five UNSET locally and on the laptop:
# unset, the app behaves exactly as before (local disk uploads, the long-running worker,
# open self sign-up). The owner pastes the values into Vercel -> Settings -> Environment
# Variables (Production) and never into a file. docs/CLOUD-STAGING.md says where each comes from.
#
# The Supabase session pooler (port 5432). Only `npm run vercel-build` reads it, to run
# `prisma migrate deploy` on production builds; DATABASE_URL there is the transaction pooler.
# DIRECT_URL=
#
# Uploaded documents go to the private Supabase Storage bucket `documents` when BOTH are
# set. The key is the secret key (sb_secret_...) or the legacy service_role key; it is
# server-only: never prefix it NEXT_PUBLIC_, never log it.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Guards POST /api/worker/tick and /api/worker/maintenance (Authorization: Bearer <value>).
# The same value lives in Supabase Vault as `cron_secret`. Unset, both routes answer 401.
# CRON_SECRET=
