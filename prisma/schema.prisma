generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (brief §5 — values are verbatim) ────────────────────────────

enum Role {
  admin
  it_staff
  purchasing_staff
  finance_staff
  viewer
}

/// Users & access (spec §4.1): a sign-up waits PENDING until an admin approves or declines it. Kept apart from
/// `disabled`, so "waiting for approval" never looks like a deliberately turned-off account. Named apart from
/// ApprovalState, which is the approvals queue's.
enum AccountApprovalState {
  APPROVED
  PENDING
  DECLINED
}

/// Phase 13. Lives on the category. Each asset also carries a copy (Asset.cls,
/// default IT); the asset_class_invariants trigger holds the two equal on every
/// write that touches it. See spec §2.
enum AssetClass {
  IT
  PURCHASING
}

enum AssetStatus {
  DEPLOYED
  SPARE
  DEFECTIVE
  DONATED
  TEMPORARY
  BUYOUT
  DISPOSE
  MISSING
  // Purchasing-class vocabulary (Phase 13). Disjoint from the eight above; a
  // trigger refuses any asset whose status is outside its class's set.
  OPERATIONAL
  STORED
  REPAIRING
  RETIRED
  SOLD
  LOST
}

/// Three-team intake (spec §2, §3): the team a field, a send-back or a notification belongs to.
/// Mirrors `Team` in src/lib/intake-rules.ts.
enum Team {
  IT
  PURCHASING
  FINANCE
}

/// Spec §3: where a purchase order sits. Replaces PurchaseRequestState (migration 38 maps the old values;
/// legacyPoState in src/lib/po-flow.ts is the same mapping). "Registered"/"Approved" are derived, never stored.
enum PurchaseOrderState {
  WITH_IT
  SENT_BACK
  READY
  CANCELLED
}

/// Spec §7: what a bell notification is about.
enum NotificationKind {
  SENT_BACK
  TO_CHECK
  CHANGED
}

/// Migration 39 (PO form redesign, spec §4): how a purchase order was paid. Labels: PAID_BY_LABEL in src/lib/po-flow.ts.
enum PaidBy {
  CREDIT_CARD
  DEBIT_CARD
}

enum PurchaseUnitState {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalState {
  PENDING
  CLAIMED
  APPROVED
  REJECTED
  EXECUTED
  EXECUTION_FAILED
}

enum ApprovalType {
  lifecycle_assign        @map("lifecycle.assign")
  lifecycle_replace       @map("lifecycle.replace")
  lifecycle_transfer      @map("lifecycle.transfer")
  lifecycle_return        @map("lifecycle.return")
  lifecycle_change_status @map("lifecycle.change-status")
}

enum ReservationState {
  ACTIVE
  FULFILLED
  RELEASED
  EXPIRED
}

enum EmploymentStatus {
  ACTIVE
  OFFBOARDING
  OFFBOARDED
}

enum GroupKind {
  INTERNAL
  CLIENT
}

enum SetupState {
  DONE
  NOT_YET
  NOT_NEEDED
  /// Phase 40 (spec §7): access taken away by offboarding.
  REMOVED
}

enum Priority {
  NORMAL
  HIGH
  URGENT
}

enum NoteKind {
  COMMENT
  SUBMIT
  IT_REVIEW
  IT_REJECT
  REQUEST_INFO
  CANCEL
  COMPLETE
  RECEIVE
  // Migration 38 (spec §3): the purchase-order thread. The kinds above stay so history still renders.
  PO_SAVED
  PO_SENT_BACK
  PO_RESUBMITTED
  PO_FIXED
  PO_REGISTERED
  PO_LINE_CLOSED
  PO_CANCELLED
}

enum JobType {
  EXECUTE_APPROVAL
  DELIVER_WEBHOOK
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  DEAD
}

enum DeliveryStatus {
  PENDING
  RETRYING
  DELIVERED
  DEAD
}

// ── Identity & access ─────────────────────────────────────────────────

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  name                     String
  passwordHash             String? // null = SSO-only account
  role                     Role
  isPermanentAdmin         Boolean                 @default(false)
  disabled                 Boolean                 @default(false)
  entraObjectId            String?                 @unique
  /// Users & access (spec §4.1): one account per employee; optional for shared or service accounts.
  employeeId               String?                 @unique
  employee                 Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// True after an admin creates the account or resets its password; the person picks their own at next sign-in.
  mustChangePassword       Boolean                 @default(false)
  passwordChangedAt        DateTime?
  lastSignInAt             DateTime?
  /// Carried in the JWT; the guards sign out any token whose copy differs (spec §4.2). Bump with bumpSessionVersion.
  sessionVersion           Int                     @default(0)
  approvalState            AccountApprovalState    @default(APPROVED)
  approvalDecidedAt        DateTime?
  approvalDecidedById      String?
  approvalDecidedBy        User?                   @relation("approvalDecidedBy", fields: [approvalDecidedById], references: [id], onDelete: SetNull)
  approvalsDecided         User[]                  @relation("approvalDecidedBy")
  createdById              String?
  createdBy                User?                   @relation("userCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usersCreated             User[]                  @relation("userCreatedBy")
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @default(now()) @updatedAt
  preferences              UserPreference[]
  purchaseOrders           PurchaseOrder[]         @relation("requestedBy")
  reviewedOrders           PurchaseOrder[]         @relation("reviewedBy")
  sentBackOrders           PurchaseOrder[]         @relation("poSentBackBy")
  notes                    NoteEntry[]
  claimedApprovals         Approval[]              @relation("claimedBy")
  requestedApprovals       Approval[]              @relation("approvalRequestedBy")
  documents                AssetDocument[]
  rateEvents               RateEvent[]
  financeConfirmed         Asset[]                 @relation("financeConfirmedBy")
  financeReturned          Asset[]                 @relation("financeReturnedBy")
  itVerifiedAssets         Asset[]                 @relation("itVerifiedBy")
  slotExceptionsCreated    EmployeeSlotException[] @relation("slotExceptionCreatedBy")
  acknowledgementsRecorded Acknowledgement[]       @relation("acknowledgementRecordedBy")
  bankAccountsCreated      VendorBankAccount[]     @relation("bankAccountsCreated")
  vendorDocuments          VendorDocument[]        @relation("vendorDocuments")
  requestDocuments         RequestDocument[]       @relation("requestDocuments")
  stockLotsReceived        StockLot[]              @relation("stockLotsReceived")
  stockMovements           StockMovement[]         @relation("stockMovements")
  stockLotDocuments        StockLotDocument[]      @relation("stockLotDocuments")
  stocktakesOpened         Stocktake[]             @relation("stocktakesOpened")
  stocktakesPosted         Stocktake[]             @relation("stocktakesPosted")
  stocktakeLinesCounted    StocktakeLine[]         @relation("stocktakeLinesCounted")
  employeeTransfers        EmployeeTransfer[]      @relation("employeeTransfers")
  purchaseRecordsCreated   PurchaseRecord[]        @relation("purchaseRecordsCreated")
  employeeNotes            EmployeeNote[]
  crisConversations        CrisConversation[]
  assetNotesAuthored       AssetNote[]             @relation("assetNoteAuthor")
  notificationsActed       Notification[]          @relation("notificationActor")
  notificationReads        NotificationRead[]
  categoriesCreated        AssetCategory[]         @relation("categoriesCreated")
  requestDocumentsSuperseded RequestDocument[]     @relation("requestDocumentsSuperseded")
}

model UserPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String // e.g. "columns:inventory"
  value  Json

  @@unique([userId, key])
}

/// Users & access (spec §4.6): one failed sign-in per row, keyed by the lower-cased email whether or not an account
/// exists (RateEvent needs a user). Three in 15 minutes pause the email; the worker prunes rows older than a day.
model SignInAttempt {
  id        String   @id @default(cuid())
  emailKey  String
  createdAt DateTime @default(now())

  @@index([emailKey, createdAt])
}

model RateEvent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String // "mutation" | "import"
  at     DateTime @default(now())

  @@index([userId, kind, at])
}

// ── Reference data ────────────────────────────────────────────────────

model Department {
  id            String             @id @default(cuid())
  name          String             @unique
  locked        Boolean            @default(false)
  /// Phase 37 (spec §2.1): a client is a Department row with kind CLIENT.
  kind          GroupKind          @default(INTERNAL)
  /// Phase 37: null = active; set = archived (internal) / ended (client). History and people stay.
  archivedAt    DateTime?
  employees     Employee[]
  policies      EquipmentPolicy[]
  requests      PurchaseOrder[]
  stockIssues   StockMovement[]
  transfersFrom EmployeeTransfer[] @relation("transfersFrom")
  transfersTo   EmployeeTransfer[] @relation("transfersTo")
}

model AssetCategory {
  id        String      @id @default(cuid())
  name      String      @unique
  locked    Boolean     @default(false)
  cls       AssetClass  @default(IT)
  /// Phase 36 (spec ruling 5): no longer read by Register, which asks for the whole tag. Kept as data and in
  /// Admin; Phase 34's tagPrefix ?? learned-prefix suggestion is gone.
  tagPrefix String?
  /// Phase 35 (spec §5.3): Finance's straight-line policy for the category; life null = no policy.
  depreciationLifeMonths     Int?
  depreciationSalvagePercent Decimal?    @db.Decimal(5, 2)
  /// Migration 39 (spec §5): null = an IT category Purchasing created from a PO that IT hasn't confirmed yet
  /// (usable on PO forms only). Existing categories were backfilled as confirmed; every other create path is
  /// confirmed by the default (migration 39b), so createCategoryFromPo passes `confirmedAt: null` for IT explicitly.
  confirmedAt DateTime?   @default(now())
  createdById String?
  createdBy   User?       @relation("categoriesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  types     AssetType[]
  assets    Asset[]
  poLines   PurchaseOrderLine[]
}

model AssetType {
  id             String                  @id @default(cuid())
  name           String
  categoryId     String
  category       AssetCategory           @relation(fields: [categoryId], references: [id])
  locked         Boolean                 @default(false)
  assets         Asset[]
  policySlots    PolicySlot[]
  slotExceptions EmployeeSlotException[]

  @@unique([categoryId, name])
}

enum VendorContractStatus {
  NONE
  ACTIVE
  EXPIRED
  SUSPENDED
}

/// Phase 18 (spec §2.1): the supplier master record. `name` stays the unique
/// key the importer and the asset form already use; every profile column is
/// nullable so the pre-phase stub rows stay valid.
model Vendor {
  id              String               @id @default(cuid())
  name            String               @unique
  locked          Boolean              @default(false)
  registeredName  String?
  category        String?
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  registrationNo  String?
  contractStatus  VendorContractStatus @default(NONE)
  contractStart   DateTime?
  contractEnd     DateTime?
  contractTerms   String?
  notes           String?
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  assets          Asset[]
  requests        PurchaseOrder[]
  documents       VendorDocument[]
  bankAccounts    VendorBankAccount[]
  stockLots       StockLot[]
  purchaseRecords PurchaseRecord[]

  @@index([archivedAt])
  @@index([category])
  @@index([contractStatus])
}

/// Spec §2.2. Only the account number is secret (AES-256-GCM via encryptSecret,
/// AAD `${vendorId}:${label}`); bank, holder and the last four digits are clear
/// so a masked row can render without a decrypt.
model VendorBankAccount {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  label        String
  bankName     String
  accountName  String
  accountLast4 String
  ciphertext   String
  createdById  String
  createdBy    User     @relation("bankAccountsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@unique([vendorId, label])
}

/// Spec §2.3 — the shape of AssetDocument, owned by a supplier.
model VendorDocument {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  kind         String
  fileName     String
  path         String
  checksum     String
  uploadedById String?
  uploadedBy   User?    @relation("vendorDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([vendorId])
}

/// Spec §2.3 — the shape of AssetDocument, owned by a purchase order.
model RequestDocument {
  id           String        @id @default(cuid())
  orderId      String        @map("requestId")
  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind         String
  fileName     String
  path         String
  checksum     String
  uploadedById String?
  uploadedBy   User?         @relation("requestDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  /// Migration 39 (spec §5b.1): Remove marks a document superseded instead of deleting it (append-only).
  supersededAt   DateTime?
  supersededById String?
  supersededBy   User?         @relation("requestDocumentsSuperseded", fields: [supersededById], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ── People ────────────────────────────────────────────────────────────

model Employee {
  id               String                  @id @default(cuid())
  employeeNo       String                  @unique // EMP-0042
  name             String
  title            String
  departmentId     String
  department       Department              @relation(fields: [departmentId], references: [id])
  m365Status       String? // canonical: pending|active|offboarding|inactive; custom stored as-is; null = never synced
  employment       EmploymentStatus        @default(ACTIVE)
  /// stamped when employment becomes OFFBOARDING; bounds "this offboarding" so a
  /// routine return from years ago can't land on a farewell report. Cleared if
  /// they go back to ACTIVE; kept once OFFBOARDED so the report stays readable.
  offboardingAt    DateTime?
  /// Phase 23 (spec §2.1). Complete-by date for the current offboarding, day-precision UTC like
  /// loanDueAt. Set when employment enters OFFBOARDING (default addWorkingDays(today, 5), editable
  /// in the employee form), cleared on ACTIVE, kept once OFFBOARDED for the farewell report.
  offboardingDueAt DateTime?
  joinedAt         DateTime
  assets           Asset[]
  reservations     Reservation[]
  approvals        Approval[]
  slotExceptions   EmployeeSlotException[]
  acknowledgements Acknowledgement[]
  stockIssues      StockMovement[]
  transfers        EmployeeTransfer[]
  /// Phase 37 (spec §4.6): IT setup checklist; null = not recorded.
  entraStatus      SetupState?
  autopilotStatus  SetupState?
  argusStatus      SetupState?
  /// "None" | "Cloudflare WARP" | "OpenVPN" | any other name (1–40); null = not recorded.
  vpn              String?
  notes            EmployeeNote[]
  /// Users & access (spec §4.1): the sign-in account linked to this person, if any.
  user             User?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt

  @@index([employment])
  @@index([departmentId])
  @@index([name])
  @@index([joinedAt])
  @@index([employment, joinedAt])
}

/// Phase 20 (spec §2). A dated record of a department (and optionally title) change.
/// The employee row is updated in the same transaction; a wrong transfer is
/// corrected by another transfer — nothing is edited or deleted.
model EmployeeTransfer {
  id               String     @id @default(cuid())
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fromDepartmentId String
  fromDepartment   Department @relation("transfersFrom", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartmentId   String
  toDepartment     Department @relation("transfersTo", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  fromTitle        String
  toTitle          String
  effectiveAt      DateTime
  reason           String?
  actorId          String
  actor            User       @relation("employeeTransfers", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt        DateTime   @default(now())

  @@index([employeeId, effectiveAt, id])
  @@index([toDepartmentId])
}

/// Phase 37 (spec §4.5): a dated note on a person. The author edits their own; Admin may delete any.
model EmployeeNote {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  text       String
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  @@index([employeeId, createdAt])
}

// ── Assets ────────────────────────────────────────────────────────────

/// Phase 47 (spec §4.3): the shared note thread on an asset, one level of replies. Append-only:
/// no code path updates or deletes a row except stamping resolvedAt/resolvedById on a root note.
model AssetNote {
  id           String      @id @default(cuid())
  assetId      String
  asset        Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  parentId     String?
  parent       AssetNote?  @relation("assetNoteReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies      AssetNote[] @relation("assetNoteReplies")
  authorId     String?
  author       User?       @relation("assetNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  /// Denormalized display name, survives user deletion.
  authorLabel  String
  body         String      @db.Text
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime    @default(now())

  @@index([assetId, createdAt])
  @@index([parentId])
}

model Asset {
  id                   String           @id @default(cuid())
  tag                  String           @unique // BR-LT-0148
  model                String
  serial               String?          @unique
  categoryId           String
  category             AssetCategory    @relation(fields: [categoryId], references: [id])
  typeId               String?
  type                 AssetType?       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  status               AssetStatus      @default(SPARE)
  /// @default(IT) is scaffolding: it keeps every insert path that predates Phase
  /// 13 working while later tasks teach each one to set this from the category.
  /// The asset_class_invariants trigger -- not the default -- is the guarantee:
  /// it holds this equal to the category's cls, and the status inside that
  /// class's set, on every write that touches status, cls or categoryId. It
  /// does NOT make the value immutable: at the database level a single-statement
  /// change of category, cls and status together is legal.
  cls                  AssetClass       @default(IT)
  assigneeId           String?
  assignee             Employee?        @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  purchasedAt          DateTime?
  cost                 Decimal?         @db.Decimal(12, 2)
  /// Migration 38: the PO this asset was registered from (column keeps its old name).
  purchaseOrderId      String?            @map("purchaseRequestId")
  purchaseOrder        PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  /// Phase 18 (spec §2.5): stamped by the CSV importer on CREATE only. Provenance
  /// is DERIVED from this and purchaseOrderId (src/lib/provenance.ts) — never stored.
  importedAt           DateTime?
  purchaseOrderLineId  String?            @map("purchaseUnitId")
  purchaseOrderLine    PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  warrantyUntil        DateTime?
  // repair fields (repairs view = saved filter over status=DEFECTIVE; no new enum)
  vendorId             String?
  vendor               Vendor?          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  rmaRef               String?
  repairQuote          Decimal?         @db.Decimal(12, 2)
  defectiveSince       DateTime?
  /// Phase 26: set when the status leaves DEFECTIVE, cleared when it re-enters;
  /// pairs with defectiveSince to close the Down interval. NULL on a closed
  /// repair = ended before this was recorded (the Down column shows "—").
  repairEndedAt        DateTime?
  notes                String?
  financeConfirmedAt   DateTime?
  financeConfirmedById String?
  financeConfirmedBy   User?            @relation("financeConfirmedBy", fields: [financeConfirmedById], references: [id], onDelete: Restrict)
  financeReturnedAt    DateTime?
  financeReturnedById  String?
  financeReturnedBy    User?            @relation("financeReturnedBy", fields: [financeReturnedById], references: [id], onDelete: Restrict)
  financeReturnReason  String?
  /// Migration 38 (spec §5): the team Finance's send-back landed on; NULL on rows returned before it.
  financeReturnedTo    Team?
  /// Phase 35 (spec §3.2): approved by Finance as NOT capitalised — no cost, no book value, no depreciation.
  financeNotCapitalised Boolean         @default(false)
  /// Phase 35 (spec §3.3): the send-back checklist — keys of REGISTRATION_FIELDS (src/lib/registration.ts).
  financeReturnFields  String[]         @default([])
  /// Phase 35 (spec §3.4): the registering department's reply on Mark corrected; cleared by Finance's next decision.
  financeResubmitNote  String?
  /// Phase 14: set when IT checked a Purchasing-registered IT asset, or at
  /// creation when IT registered it. NULL on an IT asset = awaiting IT's check.
  /// Always NULL on a Purchasing asset (isAwaitingItCheck includes the class).
  itVerifiedAt         DateTime?
  itVerifiedById       String?
  itVerifiedBy         User?            @relation("itVerifiedBy", fields: [itVerifiedById], references: [id], onDelete: Restrict)
  /// Phase 15: set when a return lands an IT device on SPARE; the device is
  /// "back, not checked" and leaves the spare pool until IT triages it, which
  /// clears this. Any other status write clears it too.
  returnedAt           DateTime?
  /// Phase 16: when a loan (status TEMPORARY) is due back. Set by an assignment
  /// that lands on TEMPORARY; every other status write clears it.
  loanDueAt            DateTime?
  brand                String?
  /// supplier invoice or receipt number, as Purchasing registered it
  invoiceRef           String?
  /// Phase 34 (spec §4.5): official receipt (OR) number, beside invoiceRef.
  receiptRef           String?
  /// "manufacturer" | "vendor" | "both" — validated by zod, not an enum (spec §7.1).
  warrantyCoveredBy    String?
  warrantyContact      String?
  /// Phase 34 (spec §5): set when its label was printed from the Labels tab; NULL = waiting.
  labelPrintedAt       DateTime?
  /// Phase 35 (spec §5.3): a per-asset override — life AND salvage (pesos) together, or neither.
  depreciationLifeMonths Int?
  depreciationSalvage    Decimal?         @db.Decimal(12, 2)
  depreciationNote       String?
  purchaseRecordId     String?
  purchaseRecord       PurchaseRecord?  @relation(fields: [purchaseRecordId], references: [id], onDelete: Restrict)
  secrets              AssetSecret[]
  documents            AssetDocument[]
  assetNotes           AssetNote[]
  reservations         Reservation[]
  approvals            Approval[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now()) @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([typeId])
  @@index([purchaseOrderId])
  @@index([purchaseOrderLineId])
  @@index([vendorId])
  @@index([financeConfirmedAt])
  @@index([financeReturnedAt])
  @@index([itVerifiedAt])
  @@index([returnedAt])
  @@index([loanDueAt])
  @@index([cls])
  @@index([importedAt])
  @@index([purchaseRecordId])
  @@index([labelPrintedAt])
  @@index([warrantyUntil])
  @@index([purchasedAt])
  @@index([defectiveSince])
  @@index([updatedAt])
  @@index([cls, status])
}

model AssetSecret {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label      String
  ciphertext String // AES-256-GCM v1: base64(version || iv || tag || data), AAD = "assetId:label", key from SECRET_ENCRYPTION_KEY
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([assetId, label])
}

model AssetDocument {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kind         String // "receipt" | "accountability-form" | ...
  fileName     String
  path         String // relative path under uploads/ volume
  checksum     String
  /// Phase 47: bytes on disk; NULL on rows uploaded before it.
  size         Int?
  signed       Boolean  @default(false)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([assetId])
}

/// Phase 34 (spec §7.2): one per Register submit — the registration batch the Labels queue groups
/// by, and the purchase (fees live here; the total is computed, never stored).
model PurchaseRecord {
  id          String     @id @default(cuid())
  cls         AssetClass
  vendorId    String?
  vendor      Vendor?    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchasedAt DateTime?
  invoiceRef  String?
  receiptRef  String?
  unitCost    Decimal?   @db.Decimal(12, 2)
  fees        Decimal?   @db.Decimal(12, 2)
  quantity    Int
  createdById String
  createdBy   User       @relation("purchaseRecordsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  /// Migration 38: the PO a Register submit came from; NULL for a registration with no PO (spec §4 way 3).
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  assets      Asset[]

  @@index([createdAt])
  @@index([cls, createdAt])
  @@index([purchaseOrderId])
}

model Reservation {
  id         String           @id @default(cuid())
  assetId    String
  asset      Asset            @relation(fields: [assetId], references: [id])
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  state      ReservationState @default(ACTIVE)
  reason     String?
  /// Phase 26 (spec §4.3). Last day the hold is live, day-precision UTC midnight like
  /// Employee.offboardingDueAt and Stocktake.dueAt: every writer goes through dayFromISO (or the
  /// seed's dayFloor), so the worker's raw-instant cutoff — start of today, Asia/Manila — and
  /// holdStatus's calendar arithmetic name the same day. A wall-clock value here would be
  /// swept a day early for any time-of-day from 16:00 UTC on.
  expiresAt  DateTime?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  @@index([assetId])
  @@index([employeeId])
  @@index([state, createdAt])
  @@index([state, expiresAt])
}

// ── Purchasing ────────────────────────────────────────────────────────

/// Migration 38 (spec §3): a purchase order records something already bought. Table keeps its old name.
model PurchaseOrder {
  id            String             @id @default(cuid())
  refNo         String             @unique // PO-0188 (sequence purchase_request_ref_seq)
  /// No default: every writer picks it (stateAfterSave / stateAfterResubmit in src/lib/po-flow.ts).
  state         PurchaseOrderState
  requestedById String
  requestedBy   User               @relation("requestedBy", fields: [requestedById], references: [id])
  /// Phase 18 (spec §5.2): one supplier per order, optional, any state.
  vendorId      String?
  vendor        Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  /// Phase 18 (spec §5.1): the department it's for. Nullable at the database (pre-phase rows).
  departmentId  String?
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  documents     RequestDocument[]
  /// Migration 38 (spec §3): SI number, OR number, purchase date and fees. NULL on legacy rows.
  invoiceRef    String?
  receiptRef    String?
  purchasedAt   DateTime?
  fees          Decimal?           @db.Decimal(12, 2)
  /// Migration 39 (PO form redesign, spec §4): the vendor's PO number (unique case- and space-insensitively among
  /// POs that aren't CANCELLED — a partial unique index in SQL only), how it was paid, and the seven totals typed
  /// off the sales invoice (never computed; checkTotals in src/lib/po-totals.ts). NULL on legacy rows.
  poNumber         String?
  paidBy           PaidBy?
  totalSales       Decimal?        @db.Decimal(12, 2)
  lessVat          Decimal?        @db.Decimal(12, 2)
  netOfVat         Decimal?        @db.Decimal(12, 2)
  discount         Decimal?        @db.Decimal(12, 2)
  amountDue        Decimal?        @db.Decimal(12, 2)
  addVat           Decimal?        @db.Decimal(12, 2)
  totalAmountDue   Decimal?        @db.Decimal(12, 2)
  /// Whether the typed totals added up at the last write. Never blocks a save.
  totalsConsistent Boolean?
  /// True for POs created on the new form: its required fields apply. Legacy POs stay false.
  formV2           Boolean         @default(false)
  /// Migration 38 (spec §7): the open send-back — when, who, which team, which fields, why. Cleared on resubmit.
  sentBackAt     DateTime?
  sentBackById   String?
  sentBackByUser User?             @relation("poSentBackBy", fields: [sentBackById], references: [id], onDelete: Restrict)
  sentBackBy     Team?
  sentBackFields String[]          @default([])
  sentBackNote   String?
  /// The old request flow's stamps — kept for history, no longer written.
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?              @relation("reviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  lines         PurchaseOrderLine[]
  notes         NoteEntry[]
  assets        Asset[]
  records       PurchaseRecord[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  @@index([state])
  @@index([requestedById])
  @@index([vendorId])
  @@index([departmentId])
  @@index([updatedAt])
  @@map("PurchaseRequest")
}

/// Migration 38: a PO line (table keeps its old name PurchaseUnit).
model PurchaseOrderLine {
  id           String            @id @default(cuid())
  orderId      String            @map("requestId")
  order        PurchaseOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description  String
  specs        String?
  qty          Int               @default(1)
  unitPrice    Decimal?          @db.Decimal(12, 2)
  /// Migration 39: free text, 1–12 characters (unitSchema in src/lib/po-units.ts).
  unit         String            @default("pc") @db.VarChar(12)
  /// Spec §3: the line's class comes from this category. NULL on legacy lines (class picked at Register).
  categoryId   String?
  category     AssetCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Spec §4 (partial deliveries): units that will never arrive, and why.
  closedShort       Int          @default(0)
  closedShortReason String?
  /// The old request flow's per-unit fields — kept for history, no longer written.
  state        PurchaseUnitState @default(PENDING)
  itSlotNotes  String?
  financeNotes String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  assets       Asset[]

  @@index([orderId])
  @@index([categoryId])
  @@map("PurchaseUnit")
}

// Append-only conversation thread (enforced by DB trigger, Task 4)
model NoteEntry {
  id        String        @id @default(cuid())
  orderId   String        @map("requestId")
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  kind      NoteKind
  text      String
  createdAt DateTime      @default(now())

  @@index([orderId])
}

/// Migration 38 (spec §7): a team-addressed bell notification, written in the same transaction as its cause.
model Notification {
  id         String             @id @default(cuid())
  team       Team
  kind       NotificationKind
  title      String
  body       String?
  href       String
  actorId    String?
  actor      User?              @relation("notificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  createdAt  DateTime           @default(now())
  reads      NotificationRead[]

  @@index([team, createdAt])
}

/// Per-person read state for a team notification.
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

// ── Approvals ─────────────────────────────────────────────────────────

model Approval {
  id               String        @id @default(cuid())
  refNo            String        @unique // APR-2039
  type             ApprovalType
  state            ApprovalState @default(PENDING)
  payload          Json // before→after change description
  priority         Priority      @default(NORMAL)
  slaAt            DateTime
  requestedById    String
  requestedBy      User          @relation("approvalRequestedBy", fields: [requestedById], references: [id])
  claimedById      String?
  claimedBy        User?         @relation("claimedBy", fields: [claimedById], references: [id], onDelete: Restrict)
  claimedAt        DateTime?
  resolvedAt       DateTime?
  resolutionReason String?
  workerError      String? // verbatim error for EXECUTION_FAILED retry UI
  assetId          String?
  asset            Asset?        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employeeId       String?
  employee         Employee?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  /// Phase 21: created already EXECUTED by a direct IT change (Phase 15) — a decision recorded, never a request queued.
  appliedDirectly  Boolean       @default(false)

  @@index([state, slaAt])
  @@index([claimedById])
  @@index([employeeId])
  @@index([assetId])
  @@index([state, updatedAt])
  @@index([appliedDirectly, resolvedAt])
  @@index([type])
}

// ── Audit (append-only by DB trigger, Task 4) ─────────────────────────

model AuditEntry {
  id         String   @id @default(cuid())
  actorId    String? // null = system
  actorLabel String // denormalized display name, survives user deletion
  entityType String // "asset" | "employee" | "approval" | ...
  entityId   String
  action     String // "create" | "update" | "SECRET_READ" | ...
  diff       Json? // { field: { from, to } } per changed field
  /// Phase 47: "web" | "import" | "cris" | "system"; NULL on rows written before it.
  source     String?
  /// Phase 47: the note, comment or reason that came with the action.
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([actorId])
  @@index([entityType, entityId, createdAt])
  @@index([entityType, action]) // Phase 27 (spec §3.1): the feeds' Action facet filters and counts here
  @@index([entityType, action, createdAt])
}

// ── Equipment policies ────────────────────────────────────────────────

model EquipmentPolicy {
  id                    String       @id @default(cuid())
  name                  String       @unique
  appliesToDepartmentId String?
  appliesToDepartment   Department?  @relation(fields: [appliesToDepartmentId], references: [id], onDelete: Restrict)
  appliesToTitle        String? // role policy beats department policy
  slots                 PolicySlot[]
}

model PolicySlot {
  id          String                  @id @default(cuid())
  policyId    String
  policy      EquipmentPolicy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
  name        String // "laptop", "monitor", ...
  assetTypeId String?
  assetType   AssetType?              @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  required    Boolean                 @default(true)
  /// Phase 16: filled only by a device on loan (status TEMPORARY); standard
  /// slots never are. computeLoadout applies the rule.
  loaner      Boolean                 @default(false)
  waivers     EmployeeSlotException[]
}

enum SlotExceptionKind {
  ADD
  WAIVE
}

/// Phase 16 (spec §3.2): one person's deviation from their resolved policy.
/// WAIVE names a policy slot they do not need (cascades away with the slot);
/// ADD is an extra slot for them alone. Applied by effectiveSlots().
model EmployeeSlotException {
  id          String            @id @default(cuid())
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind        SlotExceptionKind
  slotId      String?
  slot        PolicySlot?       @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name        String?
  assetTypeId String?
  assetType   AssetType?        @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  required    Boolean           @default(true)
  loaner      Boolean           @default(false)
  reason      String
  createdById String
  createdBy   User              @relation("slotExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())

  @@index([employeeId])
}

/// Phase 16 (spec §6): the signed accountability form, on the person.
model Acknowledgement {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  signedAt     DateTime
  fileName     String
  path         String
  checksum     String
  /// [{ assetId, tag, model, serial }] held when the form was recorded
  items        Json
  recordedById String
  recordedBy   User     @relation("acknowledgementRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([employeeId, signedAt])
}

// ── Admin ─────────────────────────────────────────────────────────────

model WebhookEndpoint {
  id         String            @id @default(cuid())
  url        String
  secret     String
  events     String[] // event names this endpoint subscribes to
  active     Boolean           @default(true)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  event         String
  payload       Json
  status        DeliveryStatus  @default(PENDING)
  attempts      Int             @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // "m365_sso", ...
  enabled     Boolean  @default(false)
  description String
  value       Json?
  updatedAt   DateTime @default(now()) @updatedAt
}

// ── Worker queue (polled with FOR UPDATE SKIP LOCKED) ─────────────────

model Job {
  id        String    @id @default(cuid())
  type      JobType
  payload   Json
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lastError String?
  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([status, runAt])
  @@index([status, lockedAt])
}

// ── Stock control (Phase 19, spec §2) ─────────────────────────────────

enum StockMovementKind {
  OPENING
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum StocktakeState {
  OPEN
  POSTED
  CANCELLED
}

/// Spec §2.1 (D2). Origin of a lot: a normal receipt, an opening-stock
/// backfill, or a positive stocktake/manual adjustment.
enum StockLotOrigin {
  RECEIPT
  OPENING
  ADJUSTMENT
}

/// Phase 19 (spec §2.1). `prefix` numbers the category's items (OS-0001);
/// `nextNumber` is the series counter, advanced inside the create transaction.
model StockCategory {
  id         String      @id @default(cuid())
  name       String      @unique
  prefix     String      @unique
  nextNumber Int         @default(1)
  archivedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  items      StockItem[]
  stocktakes Stocktake[]
}

/// Spec §2.2. The balance is NEVER a column here — it is SUM(StockMovement.quantity).
model StockItem {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  categoryId     String
  category       StockCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit           String
  packSize       Int?
  reorderLevel   Int             @default(0)
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  movements      StockMovement[]
  lots           StockLot[]
  stocktakeLines StocktakeLine[]

  @@index([categoryId])
  @@index([archivedAt])
  @@index([name])
}

/// Spec §2.3 — one per receipt; D2 consumes lots oldest-first, D1 only records them.
/// D2 (spec §2.1) adds expiry and origin; a lot's remaining quantity and every
/// value stay derived from StockAllocation, never stored.
model StockLot {
  id           String             @id @default(cuid())
  itemId       String
  item         StockItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  supplierId   String?
  supplier     Vendor?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lotDate      DateTime
  expiresAt    DateTime?
  origin       StockLotOrigin     @default(RECEIPT)
  unitCost     Decimal?           @db.Decimal(12, 2)
  quantity     Int
  reference    String?
  receivedById String
  receivedBy   User               @relation("stockLotsReceived", fields: [receivedById], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  movements    StockMovement[]
  allocations  StockAllocation[]
  documents    StockLotDocument[]

  @@index([itemId])
  @@index([supplierId])
  @@index([itemId, expiresAt])
}

/// Spec §2.4 — APPEND-ONLY (trigger stock_movement_append_only). quantity is
/// SIGNED in base units; the sign check lives in the database too.
model StockMovement {
  id           String            @id @default(cuid())
  itemId       String
  item         StockItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  kind         StockMovementKind
  quantity     Int
  lotId        String?
  lot          StockLot?         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employeeId   String?
  employee     Employee?         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reason       String?
  stocktakeId  String?
  stocktake    Stocktake?        @relation(fields: [stocktakeId], references: [id], onDelete: Restrict)
  actorId      String
  actor        User              @relation("stockMovements", fields: [actorId], references: [id], onDelete: Restrict)
  occurredAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  allocations  StockAllocation[]

  @@index([itemId, occurredAt, id])
  @@index([kind])
  @@index([stocktakeId])
  @@index([departmentId])
}

/// Spec §2.2 (D2) — APPEND-ONLY (trigger stock_allocation_append_only). Splits
/// a negative movement's quantity across the lots it drew from; a lot's
/// remaining quantity is always `quantity - SUM(allocation.quantity)`, never
/// a column.
model StockAllocation {
  id         String        @id @default(cuid())
  movementId String
  movement   StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  lotId      String
  lot        StockLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity   Int
  createdAt  DateTime      @default(now())

  @@unique([movementId, lotId])
  @@index([lotId])
  @@index([movementId])
}

/// Spec §2.3 (D2) — mirrors RequestDocument field for field; a delivery
/// receipt, invoice or other file attached to a lot.
model StockLotDocument {
  id           String   @id @default(cuid())
  lotId        String
  lot          StockLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  kind         String
  fileName     String
  path         String
  checksum     String
  uploadedById String?
  uploadedBy   User?    @relation("stockLotDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([lotId])
}

/// Spec §2.5.
model Stocktake {
  id         String          @id @default(cuid())
  refNo      String          @unique
  categoryId String?
  category   StockCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  state      StocktakeState  @default(OPEN)
  openedAt   DateTime        @default(now())
  openedById String
  openedBy   User            @relation("stocktakesOpened", fields: [openedById], references: [id], onDelete: Restrict)
  postedAt   DateTime?
  postedById String?
  postedBy   User?           @relation("stocktakesPosted", fields: [postedById], references: [id], onDelete: Restrict)
  /// Phase 23 (spec §2.2). Close-by date, set once at open (default openedAt + 3 days). Day-precision UTC.
  dueAt      DateTime
  note       String?
  lines      StocktakeLine[]
  movements  StockMovement[]

  @@index([state])
  @@index([categoryId])
}

model StocktakeLine {
  id          String    @id @default(cuid())
  stocktakeId String
  stocktake   Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  bookQty     Int
  countedQty  Int?
  countedAt   DateTime?
  countedById String?
  countedBy   User?     @relation("stocktakeLinesCounted", fields: [countedById], references: [id], onDelete: Restrict)

  @@unique([stocktakeId, itemId])
}

// ── Cris, the in-app IT assistant (Phase 41, spec §7) ─────────────────

/// One open conversation per person; New chat starts a fresh one. Private to its person.
/// The worker's prune deletes rows not updated for 30 days.
model CrisConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  /// What the person has picked in the box so far (person, slot, spare), carried between turns.
  picks     Json          @default("{}")
  /// Phase 47: sign-out stamps this; the panel shows only what came after it. Messages are kept for usage counts.
  clearedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  CrisMessage[]

  @@index([userId, updatedAt])
}

model CrisMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   CrisConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "cris" | "tool" (CrisMessageRole in src/server/cris/messages.ts)
  role           String
  /// text plus structured cards
  content        Json
  inputTokens    Int?
  outputTokens   Int?
  /// the CrisModelId that produced an assistant reply, so the month's cost prices each reply at its own model
  model          String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

/// A change Cris proposed, waiting for the person's Confirm (spec §6). Expires after 10 minutes;
/// the worker's prune deletes rows older than a day. No foreign keys: a short-lived token, not a record.
model CrisPendingAction {
  id             String    @id @default(cuid())
  userId         String
  conversationId String
  /// "assign" | "replace"
  kind           String
  input          Json
  card           Json
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  undoneAt       DateTime?
  resultRef      String?

  @@index([userId, createdAt])
}

/// Phase 46 (spec §2): one value per key per Manila calendar day, written by the worker's nightly snapshot
/// (src/server/modules/metrics/snapshot.ts) and read back as the Overview's 8-week history. Keys are SNAPSHOT_KEYS
/// (src/lib/snapshot.ts); values are counts, or centavos for money keys. Pruned after 400 days.
model MetricSnapshot {
  id        String   @id @default(cuid())
  /// the Manila calendar day (UTC-midnight Date in Prisma)
  day       DateTime @db.Date
  key       String
  value     BigInt
  createdAt DateTime @default(now())

  @@unique([day, key])
  @@index([key, day])
}
